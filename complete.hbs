<div class="pk5e-root">

  <div class="pk5e-body">
    <div class="pk5e-pane">

      {{#if locked}}
        <h2>{{actorName}}</h2>
        <p class="pk5e-note">{{summary}}</p>
      {{else}}
        <p class="pk5e-lead">
          {{pkT "abilities.lead"}}
        </p>
        <label class="pk5e-label" for="pk5e-actor">{{pkT "abilities.character"}}</label>
        <select id="pk5e-actor" data-actor>
          <option value="">{{pkT "abilities.chooseActor"}}</option>
          {{#each actors}}
          <option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}}</option>
          {{/each}}
        </select>
      {{/if}}

      {{#if hasActor}}
      {{#unless locked}}<p class="pk5e-note">{{summary}}</p>{{/unless}}

      {{#if hasSavedState}}
      <div class="pk5e-callout">
        <strong>{{#if savedAt}}{{pkT "abilities.previouslyOn" savedAt}}{{else}}{{pkT "abilities.previously"}}{{/if}}</strong>
        <p>
          {{pkT "abilities.previouslyBody"}}
        </p>
      </div>
      {{/if}}

      <p class="pk5e-note">
        {{#if isMeasured}}
          {{pkT "abilities.bonusMeasured"}}
        {{/if}}
        {{#if isFromAdvancements}}
          {{pkT "abilities.bonusAdvancements"}}
        {{/if}}
        {{#if isIgnored}}
          {{pkT "abilities.bonusNone"}}
        {{/if}}

      </p>

      <div class="pk5e-methods">
        <label><input type="radio" name="pk5e-cmethod" data-method="standard"
                      {{#if isStandard}}checked{{/if}}> {{pkT "abilities.methodStandard"}}</label>
        <label><input type="radio" name="pk5e-cmethod" data-method="pointbuy"
                      {{#if isPointBuy}}checked{{/if}}> {{pkT "abilities.methodPointBuy"}}</label>
        <label><input type="radio" name="pk5e-cmethod" data-method="roll"
                      {{#if isRoll}}checked{{/if}}> {{pkT "abilities.methodRoll"}}</label>
        <label><input type="radio" name="pk5e-cmethod" data-method="manual"
                      {{#if isManual}}checked{{/if}}> {{pkT "abilities.methodManual"}}</label>
      </div>

      {{#if isRoll}}
      <p class="pk5e-note">
        <button type="button" class="pk5e-link" data-action="rollAbilities">{{pkT "abilities.rollButton"}}</button>
      </p>
      {{/if}}
      {{#if isPointBuy}}
      <p class="pk5e-note">{{pkT "abilities.pointsLeft"}}: <strong>{{pointsLeft}}</strong> {{pkT "abilities.of"}} {{pointsTotal}}.</p>
      {{/if}}

      <table class="pk5e-abilities">
        <thead>
          <tr>
            <th>{{pkT "abilities.colAbility"}}</th>
            <th>{{pkT "abilities.colNow"}}</th>
            <th>{{pkT "abilities.colAssign"}}</th>
            <th>{{pkT "abilities.colBonus"}}</th>
            <th>{{pkT "abilities.colResult"}}</th>
            <th>{{pkT "abilities.colMod"}}</th>
          </tr>
        </thead>
        <tbody>
          {{#each rows}}
          <tr>
            <th scope="row">{{label}}</th>
            <td class="pk5e-mod">{{current}}</td>
            <td>
              {{#if ../usesPool}}
                <select data-assign="{{key}}">
                  <option value="">—</option>
                  {{#each options}}
                  <option value="{{index}}" {{#if selected}}selected{{/if}}
                          {{#if disabled}}disabled{{/if}}>{{value}}</option>
                  {{/each}}
                </select>
              {{else if ../isPointBuy}}
                <span class="pk5e-stepper">
                  <button type="button" data-action="abilityMinus" data-ability="{{key}}"
                          {{#if minusDisabled}}disabled{{/if}}>&minus;</button>
                  <span class="pk5e-stepper-value">{{value}}</span>
                  <button type="button" data-action="abilityPlus" data-ability="{{key}}"
                          {{#if plusDisabled}}disabled{{/if}}>+</button>
                </span>
              {{else}}
                <input type="number" data-manual="{{key}}" value="{{value}}" min="1" max="20">
              {{/if}}
            </td>
            <td class="pk5e-mod">{{bonusLabel}}</td>
            <td class="pk5e-mod"><strong>{{final}}</strong></td>
            <td class="pk5e-mod">{{modLabel}}</td>
          </tr>
          {{/each}}
        </tbody>
      </table>

      <button type="button" class="pk5e-link" data-action="reset">{{pkT "abilities.reset"}}</button>
      {{/if}}

    </div>
  </div>

  <footer class="pk5e-footer">
    <span class="pk5e-hint">{{pkT "abilities.footer"}}</span>
    <button type="button" class="pk5e-primary" data-action="apply"
            {{#unless canApply}}disabled{{/unless}}>{{pkT "abilities.apply"}}</button>
  </footer>

</div>
