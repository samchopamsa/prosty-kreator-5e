<div class="pk5e-root">

  <div class="pk5e-body">
    <div class="pk5e-pane">
      <p class="pk5e-lead">
        The character creator lists species, backgrounds and classes from the
        compendiums ticked here. Compendiums are grouped by their folder.
      </p>

      <div class="pk5e-bulk">
        <input type="search" data-search placeholder="Filter compendiums..." autocomplete="off">
        <button type="button" data-action="selectAll">Select all</button>
        <button type="button" data-action="selectNone">Deselect all</button>
      </div>

      <p class="pk5e-note">{{selected}} of {{total}} compendiums enabled.</p>

      <div class="pk5e-src-groups">
        {{#each groups}}
        <section class="pk5e-src-group">
          <header class="pk5e-src-header">
            <button type="button" class="pk5e-link" data-action="toggleGroup">
              {{#if allChecked}}Deselect{{else}}Select{{/if}} group
            </button>
            <span class="pk5e-src-title">{{label}}</span>
            <span class="pk5e-src-count">{{checkedCount}}/{{count}}</span>
          </header>
          {{#each packs}}
          <label class="pk5e-pack" data-search="{{label}} {{origin}}">
            <input type="checkbox" data-pack="{{id}}" {{#if checked}}checked{{/if}}>
            <span class="pk5e-pack-name">{{label}}</span>
            <span class="pk5e-pack-origin">{{origin}}</span>
          </label>
          {{/each}}
        </section>
        {{/each}}
      </div>
    </div>
  </div>

  <footer class="pk5e-footer">
    <span class="pk5e-hint">
      Tip: enabling both 2014 and 2024 compendiums shows every entry twice. The
      creator marks each one, and you can filter by edition on each step.
    </span>
    <button type="button" class="pk5e-primary" data-action="save">Save</button>
  </footer>

</div>
