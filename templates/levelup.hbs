<div class="pk5e-root">
  <div class="pk5e-body">
    <div class="pk5e-pane">

      {{#if missing}}
        <p class="pk5e-empty">{{pkT "guide.missing"}}</p>
      {{else}}

      <header class="pk5e-levelup-head">
        {{#if actorImg}}<img src="{{actorImg}}" alt="">{{/if}}
        <div>
          <h3>{{actorName}}</h3>
          <p class="pk5e-note">
            {{#each classes}}{{name}} {{levels}}{{#unless @last}}, {{/unless}}{{/each}}
          </p>
        </div>
      </header>

      {{#if atMax}}
        <p class="pk5e-empty">{{pkT "levelup.atMax"}}</p>
      {{else}}

        {{#unless inProgress}}
        <p class="pk5e-lead">{{pkT "levelup.lead"}}</p>

        <label class="pk5e-label" for="pk5e-target">{{pkT "levelup.target"}}</label>
        <select id="pk5e-target" data-target-level>
          {{#each targets}}
          <option value="{{level}}" {{#if selected}}selected{{/if}}>
            {{pkT "levelup.targetOption" level count}}
          </option>
          {{/each}}
        </select>

        <button type="button" class="pk5e-levelup-go" data-action="levelOnce" {{#if busy}}disabled{{/if}}>
          {{#if busy}}{{pkT "levelup.working"}}{{else}}{{pkT "levelup.start"}}{{/if}}
        </button>
        {{/unless}}

        {{#if inProgress}}
          <p class="pk5e-lead">{{progress}}</p>
          {{#if busy}}
          <p class="pk5e-note">{{pkT "levelup.waiting"}}</p>
          {{/if}}
        {{/if}}

        {{#if levels}}
        <section class="pk5e-levelup-changes">
          <h3 class="pk5e-gained-title">{{pkT "levelup.gained"}}</h3>
          {{#each levels}}
          <div class="pk5e-gained-group">
            <h4>{{title}}</h4>
            <div class="pk5e-gains">
              {{#each sections}}
              <div class="pk5e-gain-group">
                <span class="pk5e-gain-label">{{label}}</span>
                <span class="pk5e-gain-chips">
                  {{#each entries}}
                  {{#if uuid}}
                  <span class="pk5e-gain-chip is-readable"
                        data-tooltip="<section class='loading' data-uuid='{{uuid}}'><i class='fas fa-spinner fa-spin-pulse'></i></section>"
                        data-tooltip-direction="LEFT">
                    {{#if img}}<img src="{{img}}" alt="">{{/if}}
                    <span class="pk5e-gain-name">{{label}}</span>
                    {{#if detail}}<em>{{detail}}</em>{{/if}}
                  </span>
                  {{else}}
                  <span class="pk5e-gain-chip">
                    {{#if img}}<img src="{{img}}" alt="">{{/if}}
                    <span class="pk5e-gain-name">{{label}}</span>
                    {{#if detail}}<em>{{detail}}</em>{{/if}}
                  </span>
                  {{/if}}
                  {{/each}}
                </span>
              </div>
              {{/each}}
            </div>
          </div>
          {{/each}}
        </section>
        {{/if}}

        {{#if notes}}
        <section class="pk5e-levelup-notes">
          <h3 class="pk5e-gained-title">{{pkT "levelup.notes"}}</h3>
          <ul>
            {{#each notes}}
            <li class="pk5e-change is-warning">
              <strong>{{label}}</strong>
              {{#if hint}}<span class="pk5e-note-hint">{{hint}}</span>{{/if}}
            </li>
            {{/each}}
          </ul>
        </section>
        {{/if}}

        {{#if skipped}}
        <section class="pk5e-skipped">
          {{#each skipped}}
          <div class="pk5e-callout pk5e-skipped-item">
            <strong>{{pkT "option.title"}}</strong>
            <p>{{text}}</p>
            <button type="button" class="pk5e-link" data-action="dismissOption"
                    data-label="{{label}}" data-level="{{level}}">
              {{pkT "option.dismiss"}}
            </button>
          </div>
          {{/each}}
        </section>
        {{/if}}

        {{#if done}}
        <button type="button" class="pk5e-levelup-go" data-action="finish">
          {{pkT "levelup.finish"}}
        </button>
        {{/if}}

      {{/if}}
      {{/if}}

    </div>
  </div>

  <footer class="pk5e-footer">
    <span class="pk5e-lang-switch">
      {{#each languages}}
      <button type="button" class="pk5e-chip {{#if selected}}is-active{{/if}}"
              data-action="setLanguage" data-lang="{{code}}">{{label}}</button>
      {{/each}}
    </span>
    <span class="pk5e-lang-switch">
      {{#each themes}}
      <button type="button" class="pk5e-chip {{#if selected}}is-active{{/if}}"
              data-action="setTheme" data-theme="{{code}}">{{label}}</button>
      {{/each}}
    </span>
  </footer>
</div>
