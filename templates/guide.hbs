<div class="pk5e-root">

  <div class="pk5e-body">

    {{#if rail}}
    <nav class="pk5e-rail" aria-label="{{pkT "guide.steps"}}">
      {{#each rail}}
      <button type="button" data-action="goStep" data-step="{{key}}"
              title="{{label}}{{#if summary}} - {{summary}}{{/if}}"
              class="pk5e-rail-step {{#if active}}is-active{{/if}} {{#if done}}is-done{{/if}}">
        <span class="pk5e-guide-num">{{number}}</span>
        <span class="pk5e-rail-body">
          <span class="pk5e-rail-label">
            {{#if icon}}<i class="fa-solid {{icon}}" aria-hidden="true"></i>{{/if}}
            {{label}}
          </span>
          <span class="pk5e-rail-summary">{{#if summary}}{{summary}}{{else}}&mdash;{{/if}}</span>
        </span>
        {{#if hasSkipped}}
          <span class="pk5e-guide-alert">!</span>
        {{else if done}}
          <span class="pk5e-guide-tick">&#10003;</span>
        {{/if}}
      </button>
      {{/each}}
    </nav>
    {{/if}}

    <div class="pk5e-pane">

      {{#if missing}}
        <p class="pk5e-empty">{{pkT "guide.missing"}}</p>
      {{else if panelFailed}}
        <div class="pk5e-callout pk5e-skipped-item">
          <strong>{{pkT "guide.panelFailed"}}</strong>
          <p>{{pkT "guide.panelFailedHint"}}</p>
        </div>
      {{else}}

      {{#if startActive}}
      <details class="pk5e-disclaimer" {{#if disclaimerOpen}}open{{/if}}>
        <summary>{{pkT "guide.disclaimerTitle"}}</summary>
        <p class="pk5e-lead">{{#if introText}}{{introText}}{{else}}{{pkT "guide.intro"}}{{/if}}</p>
        <ul>
          <li>{{pkT "guide.disclaimerSource"}}</li>
          <li>{{pkT "guide.disclaimerComplete"}}</li>
          <li><strong>{{pkT "guide.disclaimerWait"}}</strong></li>
          <li>{{pkT "guide.disclaimerRedo"}}</li>
        </ul>
      </details>

      {{#if isGM}}
      <details class="pk5e-details" open>
        <summary>{{pkT "guide.ownership"}}</summary>

        <label class="pk5e-label" for="pk5e-owner">{{pkT "guide.player"}}</label>
        <select id="pk5e-owner" data-owner>
          <option value="">{{pkT "guide.nobody"}}</option>
          {{#each players}}
          <option value="{{id}}" {{#if selected}}selected{{/if}}>{{label}}</option>
          {{/each}}
        </select>
        <p class="pk5e-note">{{pkT "guide.playerHint"}}</p>

        <label class="pk5e-label" for="pk5e-folder">{{pkT "guide.folder"}}</label>
        <select id="pk5e-folder" data-folder>
          <option value="">{{pkT "guide.noFolder"}}</option>
          {{#each folders}}
          <option value="{{id}}" {{#if selected}}selected{{/if}}>{{label}}</option>
          {{/each}}
        </select>
        <button type="button" class="pk5e-link" data-action="setDefaultFolder">
          {{#if folderIsDefault}}
            {{pkT "guide.unsetDefaultFolder"}}
          {{else}}
            {{pkT "guide.setDefaultFolder"}}
          {{/if}}
        </button>
        {{#if defaultFolderName}}
        <p class="pk5e-note">{{pkT "guide.defaultFolderIs" defaultFolderName}}</p>
        {{else}}
        <p class="pk5e-note">{{pkT "guide.noDefaultFolder"}}</p>
        {{/if}}
      </details>
      {{/if}}


      <div class="pk5e-guide-step {{#if nameSet}}is-done{{/if}}">
        <div class="pk5e-guide-head">
          <span class="pk5e-guide-num">1</span>
          <i class="fa-solid fa-signature pk5e-guide-icon"></i>
          <span class="pk5e-guide-label">{{pkT "step.start"}}</span>
          {{#if nameSet}}<span class="pk5e-guide-tick">&#10003;</span>{{/if}}
        </div>
        <div class="pk5e-identity">
          <button type="button" class="pk5e-portrait {{#unless portraitSet}}is-empty{{/unless}}"
                  data-action="setPortrait" data-tooltip="{{pkT "step.portrait"}}">
            {{#if portraitSet}}
              <img src="{{portrait}}" alt="">
            {{else}}
              <i class="fa-solid fa-image" aria-hidden="true"></i>
            {{/if}}
          </button>
          <div class="pk5e-identity-body">
            <input type="text" data-field="name" value="{{actorName}}" autocomplete="off">
            {{#if portraitBlurb}}<p class="pk5e-note">{{portraitBlurb}}</p>{{/if}}
            {{#if nameHelp}}
            <details class="pk5e-help" data-help="name" {{#if nameHelpOpen}}open{{/if}}>
              <summary>{{pkT "guide.whatIsThis"}}</summary>
              <p>{{nameHelp}}</p>
            </details>
            {{/if}}
          </div>
        </div>

        {{#if startFailures}}
        <ul class="pk5e-report-list pk5e-step-findings">
          {{#each startFailures}}
          <li class="pk5e-report-item is-{{level}}">
            <span class="pk5e-report-label">{{label}}</span>
            <span class="pk5e-report-hint">{{hint}}</span>
          </li>
          {{/each}}
        </ul>
        {{/if}}
      </div>
      {{/if}}

      {{#if stepsFailed}}
      <div class="pk5e-callout pk5e-skipped-item">
        <strong>{{pkT "guide.stepsFailed"}}</strong>
        <p>{{pkT "guide.stepsFailedHint"}}</p>
      </div>
      {{/if}}

      {{#each steps}}
      {{#if active}}
      <div class="pk5e-guide-step {{#if done}}is-done{{/if}}">
        <div class="pk5e-guide-head">
          <span class="pk5e-guide-num">{{number}}</span>
          {{#if icon}}<i class="fa-solid {{icon}} pk5e-guide-icon"></i>{{/if}}
          <span class="pk5e-guide-label">{{label}}</span>
          {{#if optional}}<span class="pk5e-abbr">{{pkT "guide.optional"}}</span>{{/if}}
          {{#if hasSkipped}}
            <span class="pk5e-guide-alert">!</span>
          {{else if done}}
            <span class="pk5e-guide-tick">&#10003;</span>
          {{/if}}
        </div>

        {{#if showHelp}}
        <details class="pk5e-help" data-help="{{key}}" {{#if helpOpen}}open{{/if}}>
          <summary>{{pkT "guide.whatIsThis"}}</summary>
          <p>{{help}}</p>
        </details>
        {{/if}}

        {{#if abilityPick}}
        {{#with abilityPick}}
          <div class="pk5e-inline-pick">
            <div class="pk5e-methods">
              <label><input type="radio" name="pk5e-method" data-method="standard"
                            {{#if isStandard}}checked{{/if}}> {{pkT "abilities.methodStandard"}}</label>
              <label><input type="radio" name="pk5e-method" data-method="pointbuy"
                            {{#if isPointBuy}}checked{{/if}}> {{pkT "abilities.methodPointBuy"}}</label>
              <label><input type="radio" name="pk5e-method" data-method="roll"
                            {{#if isRoll}}checked{{/if}}> {{pkT "abilities.methodRoll"}}</label>
              <label><input type="radio" name="pk5e-method" data-method="manual"
                            {{#if isManual}}checked{{/if}}> {{pkT "abilities.methodManual"}}</label>
            </div>

            {{#if isRoll}}
            <p class="pk5e-note">
              <button type="button" class="pk5e-link" data-action="rollAbilities">{{pkT "abilities.rollButton"}}</button>
            </p>
            {{/if}}
            {{#if isPointBuy}}
            <p class="pk5e-note">{{pkT "abilities.pointsLeft"}}: <strong>{{pointsLeft}}</strong> {{pkT "abilities.of"}} {{pointsTotal}}.</p>
            {{/if}}

            <table class="pk5e-abilities">
              <thead>
                <tr>
                  <th>{{pkT "abilities.colAbility"}}</th>
                  <th>{{pkT "abilities.colNow"}}</th>
                  <th>{{pkT "abilities.colAssign"}}</th>
                  <th>{{pkT "abilities.colBonus"}}</th>
                  <th>{{pkT "abilities.colResult"}}</th>
                  <th>{{pkT "abilities.colMod"}}</th>
                </tr>
              </thead>
              <tbody>
                {{#each rows}}
                <tr>
                  <th scope="row">{{label}}</th>
                  <td class="pk5e-mod">{{current}}</td>
                  <td>
                    {{#if ../usesPool}}
                      <select data-assign="{{key}}">
                        <option value="">&mdash;</option>
                        {{#each options}}
                        <option value="{{index}}" {{#if selected}}selected{{/if}}
                                {{#if disabled}}disabled{{/if}}>{{value}}</option>
                        {{/each}}
                      </select>
                    {{else if ../isPointBuy}}
                      <span class="pk5e-stepper">
                        <button type="button" data-action="abilityMinus" data-ability="{{key}}"
                                {{#if minusDisabled}}disabled{{/if}}>&minus;</button>
                        <span class="pk5e-stepper-value">{{value}}</span>
                        <button type="button" data-action="abilityPlus" data-ability="{{key}}"
                                {{#if plusDisabled}}disabled{{/if}}>+</button>
                      </span>
                    {{else}}
                      <input type="number" data-manual="{{key}}" value="{{value}}" min="1" max="20">
                    {{/if}}
                  </td>
                  <td class="pk5e-mod">{{bonusLabel}}</td>
                  <td class="pk5e-mod"><strong>{{final}}</strong></td>
                  <td class="pk5e-mod">{{modLabel}}</td>
                </tr>
                {{/each}}
              </tbody>
            </table>

            <div class="pk5e-inline-actions">
              <button type="button" class="pk5e-link" data-action="resetAbilities">{{pkT "abilities.reset"}}</button>
              <button type="button" class="pk5e-primary" data-action="saveAbilities"
                      {{#unless canApply}}disabled{{/unless}}>{{pkT "abilities.apply"}}</button>
            </div>
          </div>
        {{/with}}

        {{else if langPick}}
        {{#with langPick}}
          <div class="pk5e-inline-pick">
            <table class="pk5e-lang-table">
              <thead>
                <tr><th>{{pkT "lang.colRoll"}}</th><th>{{pkT "lang.colLanguage"}}</th><th>{{pkT "lang.colOrigin"}}</th></tr>
              </thead>
              <tbody>
                {{#each table}}
                <tr class="{{#if known}}is-known{{/if}} {{#if highlight}}is-rolled{{/if}}">
                  <td class="pk5e-mod">{{roll}}</td>
                  <td>
                    {{name}}
                    {{#if automatic}}<span class="pk5e-abbr">{{pkT "lang.alwaysKnown"}}</span>{{/if}}
                    {{#if highlight}}<span class="pk5e-roll-badge">{{pkT "lang.rolled" hits}}</span>{{/if}}
                  </td>
                  <td>{{origin}}</td>
                </tr>
                {{/each}}
              </tbody>
            </table>

            <p class="pk5e-note">
              <button type="button" class="pk5e-link" data-action="rollLanguage">{{pkT "lang.rollButton"}}</button>
              {{#if rollCount}}
                &middot; {{pkT "lang.rolledSoFar"}}: <strong>{{rolls}}</strong>
                &middot; <button type="button" class="pk5e-link" data-action="clearRolls">{{pkT "lang.clear"}}</button>
              {{/if}}
            </p>

            <p class="pk5e-note">
              {{pkT "lang.commonNote"}} <strong>{{extras}}</strong>.
              {{#if overLimit}} {{pkT "lang.overLimit"}}{{/if}}
            </p>

            <input type="search" data-language-search value="{{query}}"
                   placeholder="{{pkT 'lang.search'}}" autocomplete="off">

            <div class="pk5e-lang-groups">
              {{#each groups}}
              <section class="pk5e-lang-group">
                <h4 class="pk5e-lang-heading">{{label}}</h4>
                {{#each languages}}
                <label class="pk5e-pack" data-search="{{search}}">
                  <input type="checkbox" data-language="{{key}}"
                         {{#if checked}}checked{{/if}} {{#if locked}}disabled{{/if}}>
                  <span class="pk5e-pack-name">{{label}}</span>
                  {{#if locked}}<span class="pk5e-pack-origin">{{pkT "lang.alwaysKnown"}}</span>{{/if}}
                </label>
                {{/each}}
              </section>
              {{/each}}
            </div>

            <div class="pk5e-inline-actions">
              <button type="button" class="pk5e-primary" data-action="saveLanguages">{{pkT "lang.save"}}</button>
            </div>
          </div>
        {{/with}}

        {{else if bio}}
          <div class="pk5e-bio">
            <span class="pk5e-bio-heading">{{pkT "bio.details"}}</span>
            <div class="pk5e-bio-grid">
              {{#each bio.fields}}
              <label class="pk5e-bio-label" for="pk5e-bio-{{key}}">{{label}}</label>
              <input type="text" id="pk5e-bio-{{key}}" data-bio="{{path}}"
                     value="{{value}}" autocomplete="off">
              {{/each}}
            </div>

            <span class="pk5e-bio-heading">{{pkT "bio.personality"}}</span>
            <div class="pk5e-bio-stack">
              {{#each bio.personality}}
              <label class="pk5e-bio-label" for="pk5e-bio-{{key}}">{{label}}</label>
              <textarea id="pk5e-bio-{{key}}" data-bio="{{path}}" data-rich="1" rows="2">{{value}}</textarea>
              {{/each}}
            </div>

            <div class="pk5e-bio-stack">
              {{#each bio.notes}}
              <label class="pk5e-bio-label" for="pk5e-bio-{{key}}">{{label}}</label>
              <textarea id="pk5e-bio-{{key}}" data-bio="{{path}}" data-rich="1" rows="4">{{value}}</textarea>
              {{/each}}
            </div>
          </div>

        {{else if importing}}
          <p class="pk5e-importing">
            <i class="fa-solid fa-hourglass-half"></i>
            {{pkT "guide.importing"}}
          </p>
        {{else if done}}
          {{#if entries}}
            {{#each entries}}
            <div class="pk5e-entry">
              <div class="pk5e-guide-chosen">
                {{#if img}}
                  <img src="{{img}}" alt="">
                {{else}}
                  <div class="pk5e-guide-empty-art is-done" aria-hidden="true">&#10003;</div>
                {{/if}}
                <div class="pk5e-chosen-body">
                  <span class="pk5e-guide-result">{{name}}</span>
                  {{#if summary}}<p class="pk5e-guide-summary">{{summary}}</p>{{/if}}
                </div>
              </div>
              <div class="pk5e-guide-actions">
                <button type="button" class="pk5e-link" data-action="removeStep"
                        data-step="{{../key}}" data-item="{{itemId}}">{{pkT "guide.remove"}}</button>
                {{#if canDelevel}}
                <button type="button" class="pk5e-link" data-action="delevel"
                        data-class-id="{{itemId}}" data-level="{{level}}">
                  {{pkT "option.delevelShort"}}
                </button>
                {{/if}}
                {{#if @last}}{{#unless ../groupLevelUp}}{{#if ../levelUp}}
                <button type="button" class="pk5e-link" data-action="levelUp">
                  {{pkT "guide.levelUp"}}
                </button>
                {{/if}}{{/unless}}{{/if}}
              </div>

              {{#if skipped}}
              <div class="pk5e-callout pk5e-skipped-item">
                <strong>{{pkT "guide.skippedTitle"}}</strong>
                <p>{{pkT "guide.skippedBody" kindOf}}</p>
                <button type="button" data-action="redoStep"
                        data-step="{{../key}}" data-item="{{itemId}}">
                  {{pkT "guide.skippedFix" kind}}
                </button>
              </div>
              {{/if}}
            </div>
            {{/each}}

            {{#if groupLevelUp}}
            <div class="pk5e-guide-actions pk5e-group-actions">
              <button type="button" class="pk5e-link" data-action="levelUp">
                {{pkT "guide.levelUp"}}
              </button>
            </div>
            {{/if}}
          {{else}}
            <div class="pk5e-guide-chosen">
              <div class="pk5e-guide-empty-art is-done" aria-hidden="true">&#10003;</div>
              <div class="pk5e-chosen-body">
                <span class="pk5e-guide-result">{{result}}</span>
                {{#if summary}}<p class="pk5e-guide-summary">{{summary}}</p>{{/if}}
              </div>
            </div>
            <div class="pk5e-guide-actions">
              <button type="button" class="pk5e-link"
                      data-action="{{#if action}}{{action}}{{else}}finalise{{/if}}">{{pkT "guide.change"}}</button>
              {{#if levelUp}}
              <button type="button" class="pk5e-link" data-action="levelUp">
                {{pkT "guide.levelUp"}}
              </button>
              {{/if}}
            </div>
          {{/if}}

          {{#if gains}}
          <div class="pk5e-gains">
            {{#each gains}}
            <div class="pk5e-gain-group">
              <span class="pk5e-gain-label">{{label}}</span>
              <span class="pk5e-gain-chips">
                {{#each entries}}
                {{#if uuid}}
                <span class="pk5e-gain-chip is-readable"
                      data-tooltip="<section class='loading' data-uuid='{{uuid}}'><i class='fas fa-spinner fa-spin-pulse'></i></section>"
                      data-tooltip-direction="LEFT">
                  {{#if img}}<img src="{{img}}" alt="">{{/if}}
                  <span class="pk5e-gain-name">{{label}}</span>
                  {{#if detail}}<em>{{detail}}</em>{{/if}}
                </span>
                {{else}}
                <span class="pk5e-gain-chip">
                  {{#if img}}<img src="{{img}}" alt="">{{/if}}
                  <span class="pk5e-gain-name">{{label}}</span>
                  {{#if detail}}<em>{{detail}}</em>{{/if}}
                </span>
                {{/if}}
                {{/each}}
              </span>
            </div>
            {{/each}}
          </div>
          {{/if}}

          {{#if failures}}
          <ul class="pk5e-report-list pk5e-step-findings">
            {{#each failures}}
            <li class="pk5e-report-item is-{{level}}">
              <span class="pk5e-report-label">{{label}}</span>
              <span class="pk5e-report-hint">{{hint}}</span>
            </li>
            {{/each}}
          </ul>
          {{/if}}
        {{else}}
          <div class="pk5e-guide-chosen">
            <div class="pk5e-guide-empty-art" aria-hidden="true">?</div>
            <div class="pk5e-chosen-body">
              <span class="pk5e-guide-result pk5e-guide-result-empty">&mdash;</span>
              <p class="pk5e-guide-summary">{{blurb}}</p>
              {{#if expandHint}}
              <p class="pk5e-expand-hint">{{expandHint}}</p>
              {{/if}}
            </div>
          </div>

          <div class="pk5e-step-buttons">
            {{#if removable}}
            <button type="button" data-action="addStep" data-step="{{key}}">{{pkT "guide.choose" actionLabel}}</button>
            {{else}}
            <button type="button" data-action="{{#if action}}{{action}}{{else}}finalise{{/if}}">
              {{#if optional}}{{pkT "guide.addOptional" actionLabel}}{{else}}{{pkT "guide.set" actionLabel}}{{/if}}
            </button>
            {{/if}}
            {{#if levelUp}}
            <button type="button" data-action="levelUp">{{pkT "guide.levelUp"}}</button>
            {{/if}}
          </div>
        {{/if}}
      </div>
      {{/if}}
      {{/each}}

      {{#if reportActive}}
      <div class="pk5e-guide-step {{#if ready}}is-done{{/if}}">
        <div class="pk5e-guide-head">
          <span class="pk5e-guide-num">{{reportNumber}}</span>
          <i class="fa-solid fa-clipboard-check pk5e-guide-icon"></i>
          <span class="pk5e-guide-label">{{pkT "step.report"}}</span>
          <button type="button" class="pk5e-link" data-action="recheck">{{pkT "guide.recheck"}}</button>
        </div>

        <p class="pk5e-note">{{pkT "guide.reportBlurb"}}</p>

      {{#if skippedOptions}}
      <section class="pk5e-skipped">
        {{#each skippedOptions}}
        <div class="pk5e-callout pk5e-skipped-item">
          <strong>{{pkT "option.title"}}</strong>
          <p>{{text}}</p>
          <div class="pk5e-option-actions">
            {{#if canDelevel}}
            <button type="button" data-action="delevel" data-class-id="{{classId}}"
                    data-label="{{label}}" data-level="{{level}}">
              {{pkT "option.delevelButton" level}}
            </button>
            {{/if}}
            <button type="button" class="pk5e-link" data-action="dismissOption"
                    data-label="{{label}}" data-level="{{level}}">
              {{pkT "option.dismiss"}}
            </button>
          </div>
        </div>
        {{/each}}
      </section>
      {{/if}}

      <section class="pk5e-report {{#if ready}}is-ready{{/if}}">
        <div class="pk5e-guide-head">
          <span class="pk5e-guide-label">
            {{#if ready}}{{pkT "guide.ready"}}{{else}}{{pkT "guide.toFix" report.problems}}{{/if}}
          </span>
        </div>
        {{#if failures}}
        <ul class="pk5e-report-list">
          {{#each failures}}
          <li class="pk5e-report-item is-{{level}}">
            <span class="pk5e-report-label">{{label}}</span>
            <span class="pk5e-report-hint">{{hint}}</span>
          </li>
          {{/each}}
        </ul>
        {{else}}
        <p class="pk5e-note">{{pkT "guide.allGood"}}</p>
        {{/if}}
      </section>
      </div>
      {{/if}}

      {{/if}}
    </div>
  </div>

  <footer class="pk5e-footer">
    <span class="pk5e-progress" aria-hidden="true"><i style="width: {{progressPct}}%"></i></span>
    <span class="pk5e-lang-switch">
      {{#each languages}}
      <button type="button" class="pk5e-chip {{#if selected}}is-active{{/if}}"
              data-action="setLanguage" data-lang="{{code}}">{{label}}</button>
      {{/each}}
    </span>
    <span class="pk5e-lang-switch">
      {{#each themes}}
      <button type="button" class="pk5e-chip {{#if selected}}is-active{{/if}}"
              data-action="setTheme" data-theme="{{code}}">{{label}}</button>
      {{/each}}
    </span>
    <button type="button" data-action="postSummary">{{pkT "guide.postToChat"}}</button>
    <span class="pk5e-hint">{{progress}}</span>

    <span class="pk5e-nav">
      <button type="button" data-action="goBack" {{#unless canBack}}disabled{{/unless}}>
        {{pkT "guide.back"}}
      </button>
      <button type="button" data-action="goNext" {{#unless canNext}}disabled{{/unless}}>
        {{pkT "guide.next"}}
      </button>
      {{#if isLast}}
      <button type="button" class="pk5e-primary" data-action="finalizeGuide"
              {{#unless allDone}}disabled{{/unless}}
              data-tooltip="{{#unless allDone}}{{pkT "guide.finishFirst"}}{{/unless}}">
        {{pkT "guide.finalize"}}
      </button>
      {{else}}
      <button type="button" data-action="abortGuide">{{pkT "guide.abort"}}</button>
      {{/if}}
    </span>
  </footer>

</div>
