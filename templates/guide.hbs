<div class="pk5e-root">

  <div class="pk5e-body">
    <div class="pk5e-pane">

      {{#if missing}}
        <p class="pk5e-empty">{{pkT "guide.missing"}}</p>
      {{else if panelFailed}}
        <div class="pk5e-callout pk5e-skipped-item">
          <strong>{{pkT "guide.panelFailed"}}</strong>
          <p>{{pkT "guide.panelFailedHint"}}</p>
        </div>
      {{else}}

      <details class="pk5e-disclaimer" {{#if disclaimerOpen}}open{{/if}}>
        <summary>{{pkT "guide.disclaimerTitle"}}</summary>
        <ul>
          <li>{{pkT "guide.disclaimerSource"}}</li>
          <li>{{pkT "guide.disclaimerComplete"}}</li>
          <li><strong>{{pkT "guide.disclaimerWait"}}</strong></li>
          <li>{{pkT "guide.disclaimerRedo"}}</li>
        </ul>
      </details>

      <p class="pk5e-lead">{{#if introText}}{{introText}}{{else}}{{pkT "guide.intro"}}{{/if}}</p>

      {{#if isGM}}
      <details class="pk5e-details" open>
        <summary>{{pkT "guide.ownership"}}</summary>

        <label class="pk5e-label" for="pk5e-owner">{{pkT "guide.player"}}</label>
        <select id="pk5e-owner" data-owner>
          <option value="">{{pkT "guide.nobody"}}</option>
          {{#each players}}
          <option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}}</option>
          {{/each}}
        </select>
        <p class="pk5e-note">{{pkT "guide.playerHint"}}</p>

        <label class="pk5e-label" for="pk5e-folder">{{pkT "guide.folder"}}</label>
        <select id="pk5e-folder" data-folder>
          <option value="">{{pkT "guide.noFolder"}}</option>
          {{#each folders}}
          <option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}}</option>
          {{/each}}
        </select>
        <button type="button" class="pk5e-link" data-action="setDefaultFolder">
          {{#if folderIsDefault}}
            {{pkT "guide.unsetDefaultFolder"}}
          {{else}}
            {{pkT "guide.setDefaultFolder"}}
          {{/if}}
        </button>
        {{#if defaultFolderName}}
        <p class="pk5e-note">{{pkT "guide.defaultFolderIs" defaultFolderName}}</p>
        {{else}}
        <p class="pk5e-note">{{pkT "guide.noDefaultFolder"}}</p>
        {{/if}}
      </details>
      {{/if}}


      <div class="pk5e-guide-step is-done">
        <div class="pk5e-guide-head">
          <span class="pk5e-guide-num">1</span>
          <i class="fa-solid fa-signature pk5e-guide-icon"></i>
          <span class="pk5e-guide-label">{{pkT "step.name"}}</span>
        </div>
        <input type="text" data-field="name" value="{{actorName}}" autocomplete="off">
        {{#if nameHelp}}
        <details class="pk5e-help" data-help="name" {{#if nameHelpOpen}}open{{/if}}>
          <summary>{{pkT "guide.whatIsThis"}}</summary>
          <p>{{nameHelp}}</p>
        </details>
        {{/if}}
      </div>

      {{#if stepsFailed}}
      <div class="pk5e-callout pk5e-skipped-item">
        <strong>{{pkT "guide.stepsFailed"}}</strong>
        <p>{{pkT "guide.stepsFailedHint"}}</p>
      </div>
      {{/if}}

      {{#each steps}}
      <div class="pk5e-guide-step {{#if done}}is-done{{/if}}">
        <div class="pk5e-guide-head">
          <span class="pk5e-guide-num">{{number}}</span>
          {{#if icon}}<i class="fa-solid {{icon}} pk5e-guide-icon"></i>{{/if}}
          <span class="pk5e-guide-label">{{label}}</span>
          {{#if optional}}<span class="pk5e-abbr">{{pkT "guide.optional"}}</span>{{/if}}
          {{#if hasSkipped}}
            <span class="pk5e-guide-alert">!</span>
          {{else if done}}
            <span class="pk5e-guide-tick">&#10003;</span>
          {{/if}}
        </div>
        {{#if reference}}
        <div class="pk5e-callout pk5e-reference-callout">
          <strong>{{pkT "guide.referenceTitle"}}</strong>
          <p>
            {{pkT "guide.referenceBody"}}
          </p>
          <button type="button" class="pk5e-link pk5e-reference-link"
                  data-action="openReference" data-kind="class">
            {{pkT "guide.referenceButton"}}
          </button>
        </div>
        {{/if}}

        {{#if importing}}
          <p class="pk5e-importing">
            <i class="fa-solid fa-hourglass-half"></i>
            {{pkT "guide.importing"}}
          </p>
        {{else if done}}
          {{#if entries}}
            {{#each entries}}
            <div class="pk5e-entry">
              <div class="pk5e-guide-chosen">
                {{#if img}}
                  <img src="{{img}}" alt="">
                {{else}}
                  <div class="pk5e-guide-empty-art is-done" aria-hidden="true">&#10003;</div>
                {{/if}}
                <div class="pk5e-chosen-body">
                  <span class="pk5e-guide-result">{{name}}</span>
                  {{#if summary}}<p class="pk5e-guide-summary">{{summary}}</p>{{/if}}
                </div>
              </div>
              <div class="pk5e-guide-actions">
                <button type="button" class="pk5e-link" data-action="removeStep"
                        data-step="{{../key}}" data-item="{{itemId}}">{{pkT "guide.remove"}}</button>
                {{#if canDelevel}}
                <button type="button" class="pk5e-link" data-action="delevel"
                        data-class-id="{{itemId}}" data-level="{{level}}">
                  {{pkT "option.delevelShort"}}
                </button>
                {{/if}}
              </div>

              {{#if skipped}}
              <div class="pk5e-callout pk5e-skipped-item">
                <strong>{{pkT "guide.skippedTitle"}}</strong>
                <p>{{pkT "guide.skippedBody" kindOf}}</p>
                <button type="button" data-action="redoStep"
                        data-step="{{../key}}" data-item="{{itemId}}">
                  {{pkT "guide.skippedFix" kind}}
                </button>
              </div>
              {{/if}}
            </div>
            {{/each}}
          {{else}}
            <div class="pk5e-guide-chosen">
              <div class="pk5e-guide-empty-art is-done" aria-hidden="true">&#10003;</div>
              <div class="pk5e-chosen-body">
                <span class="pk5e-guide-result">{{result}}</span>
                {{#if summary}}<p class="pk5e-guide-summary">{{summary}}</p>{{/if}}
              </div>
            </div>
            <button type="button" class="pk5e-link"
                    data-action="{{#if action}}{{action}}{{else}}finalise{{/if}}">{{pkT "guide.change"}}</button>
          {{/if}}
        {{else}}
          <div class="pk5e-guide-chosen">
            <div class="pk5e-guide-empty-art" aria-hidden="true">?</div>
            <div class="pk5e-chosen-body">
              <span class="pk5e-guide-result pk5e-guide-result-empty">&mdash;</span>
              <p class="pk5e-guide-summary">{{blurb}}</p>
              {{#if expandHint}}
              <p class="pk5e-expand-hint">{{expandHint}}</p>
              {{/if}}
            </div>
          </div>
        {{/if}}

        {{#unless importing}}
          {{#unless done}}
            {{#if removable}}
            <button type="button" data-action="addStep" data-step="{{key}}">{{pkT "guide.choose" actionLabel}}</button>
            {{else}}
            <button type="button" data-action="{{#if action}}{{action}}{{else}}finalise{{/if}}">
              {{#if optional}}{{pkT "guide.addOptional" actionLabel}}{{else}}{{pkT "guide.set" actionLabel}}{{/if}}
            </button>
            {{/if}}
          {{/unless}}

          {{#if levelUp}}
          <button type="button" class="pk5e-link" data-action="levelUp">
            {{pkT "guide.levelUp"}}
          </button>
          {{/if}}
        {{/unless}}

        {{#if showHelp}}
        <details class="pk5e-help" data-help="{{key}}" {{#if helpOpen}}open{{/if}}>
          <summary>{{pkT "guide.whatIsThis"}}</summary>
          <p>{{help}}</p>
        </details>
        {{/if}}
      </div>
      {{/each}}

      {{#if skippedOptions}}
      <section class="pk5e-skipped">
        {{#each skippedOptions}}
        <div class="pk5e-callout pk5e-skipped-item">
          <strong>{{pkT "option.title"}}</strong>
          <p>{{text}}</p>
          <div class="pk5e-option-actions">
            {{#if canDelevel}}
            <button type="button" data-action="delevel" data-class-id="{{classId}}"
                    data-label="{{label}}" data-level="{{level}}">
              {{pkT "option.delevelButton" level}}
            </button>
            {{/if}}
            <button type="button" class="pk5e-link" data-action="dismissOption"
                    data-label="{{label}}" data-level="{{level}}">
              {{pkT "option.dismiss"}}
            </button>
          </div>
        </div>
        {{/each}}
      </section>
      {{/if}}

      <section class="pk5e-report {{#if ready}}is-ready{{/if}}">
        <div class="pk5e-guide-head">
          <span class="pk5e-guide-label">
            {{#if ready}}{{pkT "guide.ready"}}{{else}}{{pkT "guide.toFix" report.errors}}{{/if}}
          </span>
          <button type="button" class="pk5e-link" data-action="recheck">{{pkT "guide.recheck"}}</button>
        </div>
        {{#if failures}}
        <ul class="pk5e-report-list">
          {{#each failures}}
          <li class="pk5e-report-item is-{{level}}">
            <span class="pk5e-report-label">{{label}}</span>
            <span class="pk5e-report-hint">{{hint}}</span>
          </li>
          {{/each}}
        </ul>
        {{else}}
        <p class="pk5e-note">{{pkT "guide.allGood"}}</p>
        {{/if}}
      </section>


      {{/if}}
    </div>
  </div>

  <footer class="pk5e-footer">
    <span class="pk5e-lang-switch">
      {{#each languages}}
      <button type="button" class="pk5e-chip {{#if selected}}is-active{{/if}}"
              data-action="setLanguage" data-lang="{{code}}">{{label}}</button>
      {{/each}}
    </span>
    <span class="pk5e-lang-switch">
      {{#each themes}}
      <button type="button" class="pk5e-chip {{#if selected}}is-active{{/if}}"
              data-action="setTheme" data-theme="{{code}}">{{label}}</button>
      {{/each}}
    </span>
    <button type="button" data-action="postSummary">{{pkT "guide.postToChat"}}</button>
    <span class="pk5e-hint">{{progress}}</span>
    <button type="button" class="pk5e-primary" data-action="finalizeGuide"
            {{#unless allDone}}disabled{{/unless}}
            data-tooltip="{{#unless allDone}}{{pkT "guide.finishFirst"}}{{/unless}}">
      {{pkT "guide.finalize"}}
    </button>
  </footer>

</div>
