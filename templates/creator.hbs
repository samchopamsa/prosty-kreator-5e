<div class="pk5e-root">
{{!--
  Every piece of text the player sees lives in this file.
  Feel free to rewrite it for your table - the code will not mind.
--}}

<nav class="pk5e-steps">
  {{#each steps}}
  <button type="button" class="pk5e-step {{#if active}}is-active{{/if}} {{#if done}}is-done{{/if}}"
          data-action="goto" data-index="{{index}}">
    <span class="pk5e-step-num">{{number}}</span>
    <span class="pk5e-step-label">{{label}}</span>
  </button>
  {{/each}}
</nav>

<div class="pk5e-body">

  {{#if isIntro}}
  <div class="pk5e-pane">
    <h2>Let's build your character</h2>
    <p class="pk5e-lead">
      Six steps, one choice each. You do not need to know the rules - pick something
      from the list and press <strong>Next</strong>. At the end, D&amp;D itself will ask
      a few more questions (hit points, equipment, spells). That is a normal part
      of the process.
    </p>

    <label class="pk5e-label" for="pk5e-name">Character name</label>
    <input id="pk5e-name" type="text" data-field="name" value="{{wizard.name}}"
           placeholder="e.g. Elara Shadowstep" autocomplete="off">

    <div class="pk5e-sources-note">
      <p class="pk5e-note">
        Species, backgrounds and classes are read from
        <strong>{{enabledCount}}</strong> compendium(s).
      </p>
      {{#if isGM}}
      <button type="button" class="pk5e-link" data-action="configureSources">
        Configure compendium sources
      </button>
      {{/if}}
    </div>
  </div>
  {{/if}}

  {{#if isPickStep}}
  <div class="pk5e-pane pk5e-split">
    <div class="pk5e-list-col">
      <div class="pk5e-listbar">
        <input type="search" data-search placeholder="Search..." autocomplete="off">
        <div class="pk5e-rules-filter">
          {{#each rulesButtons}}
          <button type="button" class="pk5e-chip {{#if active}}is-active{{/if}}"
                  data-action="setRules" data-value="{{value}}">{{label}}</button>
          {{/each}}
        </div>
      </div>
      {{#if emptyList}}
      <p class="pk5e-empty">
        Nothing to show. Either no enabled compendium holds this type of item, or
        the edition filter above hides everything. Try <strong>All</strong>.
      </p>
      {{/if}}
      <div class="pk5e-options">
        {{#each list}}
        <button type="button" class="pk5e-option {{#if selected}}is-selected{{/if}}"
                data-action="pick" data-kind="{{../kind}}" data-uuid="{{uuid}}"
                data-search="{{search}}">
          <img src="{{img}}" alt="">
          <span class="pk5e-option-text">
            <span class="pk5e-option-name">{{name}}</span>
            <span class="pk5e-option-meta">
              {{#if hasRules}}<span class="pk5e-badge pk5e-badge-{{rules}}">{{rules}}</span>{{/if}}
              {{origin}}
            </span>
          </span>
        </button>
        {{/each}}
      </div>
    </div>

    <div class="pk5e-detail-col">
      {{#if selected}}
        <h3>{{selected.name}}</h3>
        <p class="pk5e-note">
          {{#if selected.hasRules}}<span class="pk5e-badge pk5e-badge-{{selected.rules}}">{{selected.rules}}</span>{{/if}}
          Source: {{selected.origin}} &middot; {{selected.packLabel}}
        </p>
        <div class="pk5e-detail-text">{{{detail}}}</div>
        <button type="button" class="pk5e-link" data-action="clearPick" data-kind="{{kind}}">
          Clear selection
        </button>
      {{else}}
        <p class="pk5e-placeholder">
          Pick something on the left to read about it.
        </p>
      {{/if}}
    </div>
  </div>
  {{/if}}

  {{#if isEquipment}}
  <div class="pk5e-pane">
    <h2>Starting equipment</h2>
    {{#if noEquipment}}
      <p class="pk5e-lead">
        Neither your class nor your background lists starting equipment, so there
        is nothing to choose here. Press <strong>Next</strong>.
      </p>
    {{else}}
      <p class="pk5e-lead">
        Pick what you set out with. Where you see a choice, one option is already
        selected for you - changing it is optional.
      </p>
    {{/if}}

    {{#each equipment}}
    <section class="pk5e-equip-source">
      <header class="pk5e-equip-header">
        <span class="pk5e-equip-title">{{sourceName}}</span>
        {{#if hasWealth}}
        <span class="pk5e-equip-modes">
          <button type="button" class="pk5e-chip {{#unless isGold}}is-active{{/unless}}"
                  data-action="setEquipMode" data-source="{{kind}}" data-mode="items">Gear</button>
          <button type="button" class="pk5e-chip {{#if isGold}}is-active{{/if}}"
                  data-action="setEquipMode" data-source="{{kind}}" data-mode="gold">{{wealth}} gp instead</button>
        </span>
        {{/if}}
      </header>

      {{#if isGold}}
        <p class="pk5e-note">Taking {{wealth}} gp instead of gear from this source.</p>
      {{else}}
        {{#each groups}}
        <div class="pk5e-equip-group">
          {{#each options}}
          <div class="pk5e-equip-option {{#if selected}}is-selected{{/if}}">
            {{#if ../isChoice}}
            <button type="button" class="pk5e-equip-radio"
                    data-action="chooseOption" data-group="{{../id}}" data-option="{{id}}">
              {{#if selected}}&#9679;{{else}}&#9675;{{/if}} {{label}}
            </button>
            {{else}}
            <span class="pk5e-equip-fixed">{{label}}</span>
            {{/if}}

            {{#if selected}}
              {{#each parts}}
                {{#if unavailable}}
                <div class="pk5e-equip-pick">
                  <label>{{name}}</label>
                  <span class="pk5e-note">No matching item in your enabled compendiums - add it by hand later.</span>
                </div>
                {{/if}}
                {{#if needsPick}}
                <div class="pk5e-equip-pick">
                  <label>{{name}}{{#if fallback}} (showing all){{/if}}</label>
                  <select data-equip-pick="{{id}}">
                    <option value="">— choose —</option>
                    {{#each candidates}}
                    <option value="{{uuid}}" {{#if selected}}selected{{/if}}>{{name}}</option>
                    {{/each}}
                  </select>
                </div>
                {{/if}}
              {{/each}}
            {{/if}}
          </div>
          {{/each}}
        </div>
        {{/each}}
      {{/if}}
    </section>
    {{/each}}
  </div>
  {{/if}}

  {{#if isAbilities}}
  <div class="pk5e-pane">
    <h2>Ability scores</h2>
    <p class="pk5e-lead">
      Six numbers describing your character. Higher is better. Enter your
      <strong>base</strong> scores here - the system adds your background bonuses by itself.
    </p>

    <div class="pk5e-methods">
      <label><input type="radio" name="pk5e-method" data-method="standard"
                    {{#if abilities.isStandard}}checked{{/if}}> Standard array</label>
      <label><input type="radio" name="pk5e-method" data-method="pointbuy"
                    {{#if abilities.isPointBuy}}checked{{/if}}> Point buy</label>
      <label><input type="radio" name="pk5e-method" data-method="roll"
                    {{#if abilities.isRoll}}checked{{/if}}> Roll dice</label>
      <label><input type="radio" name="pk5e-method" data-method="manual"
                    {{#if abilities.isManual}}checked{{/if}}> Manual</label>
    </div>

    {{#if abilities.isStandard}}
    <p class="pk5e-note">Assign 15, 14, 13, 12, 10 and 8 - each exactly once.</p>
    {{/if}}
    {{#if abilities.isRoll}}
    <p class="pk5e-note">
      Roll 4d6 and drop the lowest die, six times, then assign the results.
      <button type="button" class="pk5e-link" data-action="rollAbilities">Roll dice</button>
    </p>
    {{/if}}
    {{#if abilities.isPointBuy}}
    <p class="pk5e-note">
      You have {{abilities.pointsTotal}} points. Remaining:
      <strong>{{abilities.pointsLeft}}</strong>. Range 8-15.
    </p>
    {{/if}}

    <table class="pk5e-abilities">
      <thead>
        <tr><th>Ability</th><th>Score</th><th>Modifier</th></tr>
      </thead>
      <tbody>
        {{#each abilities.rows}}
        <tr>
          <th scope="row">{{label}} <span class="pk5e-abbr">{{abbr}}</span></th>
          <td>
            {{#if ../abilities.isPointBuy}}
              <span class="pk5e-stepper">
                <button type="button" data-action="abilityMinus" data-ability="{{key}}"
                        {{#if minusDisabled}}disabled{{/if}}>&minus;</button>
                <span class="pk5e-stepper-value">{{value}}</span>
                <button type="button" data-action="abilityPlus" data-ability="{{key}}"
                        {{#if plusDisabled}}disabled{{/if}}>+</button>
              </span>
            {{else if ../abilities.isManual}}
              <input type="number" data-manual="{{key}}" value="{{value}}" min="1" max="20">
            {{else}}
              <select data-assign="{{key}}">
                <option value="">—</option>
                {{#each options}}
                <option value="{{index}}" {{#if selected}}selected{{/if}}
                        {{#if disabled}}disabled{{/if}}>{{value}}</option>
                {{/each}}
              </select>
            {{/if}}
          </td>
          <td class="pk5e-mod">{{modLabel}}</td>
        </tr>
        {{/each}}
      </tbody>
    </table>

    <button type="button" class="pk5e-link" data-action="resetAbilities">Reset</button>
  </div>
  {{/if}}

  {{#if isSummary}}
  <div class="pk5e-pane">
    <h2>Summary</h2>
    <dl class="pk5e-summary">
      <dt>Name</dt><dd>{{wizard.name}}</dd>
      <dt>Species</dt><dd>{{#if wizard.species}}{{wizard.species.name}}{{else}}—{{/if}}</dd>
      <dt>Background</dt><dd>{{#if wizard.background}}{{wizard.background.name}}{{else}}—{{/if}}</dd>
      <dt>Class</dt><dd>{{#if wizard.class}}{{wizard.class.name}} (level 1){{else}}—{{/if}}</dd>
      <dt>Equipment</dt><dd>{{equipmentSummary}}</dd>
    </dl>

    <table class="pk5e-abilities pk5e-abilities-compact">
      <tbody>
        <tr>{{#each summaryAbilities}}<th>{{label}}</th>{{/each}}</tr>
        <tr>{{#each summaryAbilities}}<td>{{value}}</td>{{/each}}</tr>
        <tr>{{#each summaryAbilities}}<td class="pk5e-mod">{{modLabel}}</td>{{/each}}</tr>
      </tbody>
    </table>

    <div class="pk5e-callout">
      <strong>What happens next?</strong>
      <p>
        Your character sheet gets created, and the D&amp;D system opens a few small
        dialogs in turn: hit points, proficiencies, starting equipment and - if your
        class casts spells - spell selection. Pick an option in each and press
        <em>Next</em>. Do not close them with the X unless you want to skip that part.
      </p>
    </div>
  </div>
  {{/if}}

</div>

<footer class="pk5e-footer">
  <button type="button" data-action="back" {{#unless canBack}}disabled{{/unless}}>
    Back
  </button>
  <span class="pk5e-hint">{{hint}}</span>
  {{#if isSummary}}
    <button type="button" class="pk5e-primary" data-action="finish" {{#if busy}}disabled{{/if}}>
      Create character
    </button>
  {{else}}
    <button type="button" class="pk5e-primary" data-action="next" {{#unless canNext}}disabled{{/unless}}>
      Next
    </button>
  {{/if}}
</footer>
</div>
