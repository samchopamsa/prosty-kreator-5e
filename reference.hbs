<div class="pk5e-root">

  <div class="pk5e-body">
    <div class="pk5e-pane pk5e-split">

      <div class="pk5e-list-col">
        <div class="pk5e-listbar">
          <input type="search" data-search placeholder="Search..." autocomplete="off">
          {{#if isGM}}
          <button type="button" class="pk5e-chip" data-action="configure">Sources</button>
          {{/if}}
          <button type="button" class="pk5e-chip" data-action="refresh">Reload</button>
        </div>

        {{#if empty}}
        <p class="pk5e-empty">
          Nothing found. This window reads compendiums, so it shows only what is
          installed as one{{#if isGM}} and selected under Sources{{/if}}.
        </p>
        {{/if}}

        <div class="pk5e-options">
          {{#each tree}}
          <section class="pk5e-branch">
            <details data-branch="{{key}}" {{#if open}}open{{/if}}>
              <summary class="pk5e-branch-head">
                <span class="pk5e-branch-name">{{name}}</span>
                <span class="pk5e-branch-count">{{count}}</span>
              </summary>

              {{#each entries}}
              <button type="button" class="pk5e-option {{#if selected}}is-selected{{/if}}"
                      data-action="pickEntry" data-uuid="{{uuid}}" data-search="{{search}}">
                <img src="{{img}}" alt="">
                <span class="pk5e-option-text">
                  <span class="pk5e-option-name">{{name}}</span>
                  <span class="pk5e-option-meta">{{origin}}</span>
                </span>
              </button>
              {{/each}}

              {{#each children}}
              <div class="pk5e-subbranch">
                <h5 class="pk5e-lang-heading">{{name}}</h5>
                {{#each entries}}
                <button type="button" class="pk5e-option {{#if selected}}is-selected{{/if}}"
                        data-action="pickEntry" data-uuid="{{uuid}}" data-search="{{search}}">
                  <img src="{{img}}" alt="">
                  <span class="pk5e-option-text">
                    <span class="pk5e-option-name">{{name}}</span>
                    <span class="pk5e-option-meta">{{origin}}</span>
                  </span>
                </button>
                {{/each}}
              </div>
              {{/each}}
            </details>
          </section>
          {{/each}}
        </div>
      </div>

      <div class="pk5e-detail-col">
        {{#if selected}}
          <h3>{{selected.name}}</h3>
          <p class="pk5e-note">{{selected.origin}}</p>
          {{#if detail}}
            <div class="pk5e-detail-text">{{{detail}}}</div>
          {{else}}
            <p class="pk5e-placeholder">Reading...</p>
          {{/if}}
        {{else}}
          <p class="pk5e-placeholder">
            Pick an entry on the left to read about it. This window is for reading
            only - choose your class with the button in the panel.
          </p>
        {{/if}}
      </div>

    </div>
  </div>

  <footer class="pk5e-footer">
    <span class="pk5e-hint">
      Folders of the same name are merged across compendiums, so one class shows
      its subclasses from every book in one place.
    </span>
  </footer>

</div>
