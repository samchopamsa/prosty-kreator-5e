<div class="pk5e-root">

  <div class="pk5e-body">
    <div class="pk5e-pane">

      {{#if hasActor}}
      <h2>{{actorName}}</h2>

      <p class="pk5e-lead">
        {{pkT "lang.lead"}}
      </p>

      <table class="pk5e-lang-table">
        <thead>
          <tr><th>{{pkT "lang.colRoll"}}</th><th>{{pkT "lang.colLanguage"}}</th><th>{{pkT "lang.colOrigin"}}</th></tr>
        </thead>
        <tbody>
          {{#each table}}
          <tr class="{{#if known}}is-known{{/if}} {{#if highlight}}is-rolled{{/if}}">
            <td class="pk5e-mod">{{roll}}</td>
            <td>
              {{name}}
              {{#if automatic}}<span class="pk5e-abbr">{{pkT "lang.alwaysKnown"}}</span>{{/if}}
              {{#if highlight}}<span class="pk5e-roll-badge">{{pkT "lang.rolled" hits}}</span>{{/if}}
            </td>
            <td>{{origin}}</td>
          </tr>
          {{/each}}
        </tbody>
      </table>

      <p class="pk5e-note">
        <button type="button" class="pk5e-link" data-action="rollLanguage">{{pkT "lang.rollButton"}}</button>
        {{#if rollCount}}
          &middot; {{pkT "lang.rolledSoFar"}}: <strong>{{rolls}}</strong>
          &middot; <button type="button" class="pk5e-link" data-action="clearRolls">{{pkT "lang.clear"}}</button>
        {{/if}}
      </p>

      <h3>{{pkT "lang.pick"}}</h3>
      <p class="pk5e-note">
        {{pkT "lang.commonNote"}} <strong>{{extras}}</strong>.
        {{#if overLimit}} {{pkT "lang.overLimit"}}{{/if}}
      </p>

      <input type="search" data-language-search placeholder="{{pkT 'lang.search'}}" autocomplete="off">

      <div class="pk5e-lang-groups">
        {{#each groups}}
        <section class="pk5e-lang-group">
          <h4 class="pk5e-lang-heading">{{label}}</h4>
          {{#each languages}}
          <label class="pk5e-pack" data-search="{{search}}">
            <input type="checkbox" data-language="{{key}}"
                   {{#if checked}}checked{{/if}} {{#if locked}}disabled{{/if}}>
            <span class="pk5e-pack-name">{{label}}</span>
            {{#if locked}}<span class="pk5e-pack-origin">{{pkT "lang.alwaysKnown"}}</span>{{/if}}
          </label>
          {{/each}}
        </section>
        {{/each}}
      </div>
      {{else}}
      <p class="pk5e-empty">{{pkT "guide.missing"}}</p>
      {{/if}}

    </div>
  </div>

  <footer class="pk5e-footer">
    <span class="pk5e-hint">{{pkT "lang.footer"}}</span>
    <button type="button" class="pk5e-primary" data-action="apply">{{pkT "lang.save"}}</button>
  </footer>

</div>
